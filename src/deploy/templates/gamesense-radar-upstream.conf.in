# Location-context include; overwrite trust headers, never append client values.
if ($https != "on") { return 403; }
if ($args != "") { return 403; }
client_max_body_size 2m;
client_body_timeout 10s;
access_log off;
error_log /var/log/nginx/gamesense-radar-error.log crit;
proxy_http_version 1.1;
proxy_set_header Host "@@HOST@@";
proxy_set_header Connection "";
proxy_set_header X-GS-TLS "1";
proxy_set_header X-GS-Client-IP $remote_addr;
proxy_set_header X-Forwarded-For "";
proxy_set_header Forwarded "";
proxy_set_header X-Real-IP "";
proxy_request_buffering off;
proxy_buffering off;
proxy_max_temp_file_size 0;
proxy_cache off;
proxy_no_cache 1;
proxy_next_upstream off;
proxy_connect_timeout 2s;
proxy_send_timeout 15s;
proxy_read_timeout 20s;
proxy_pass http://127.0.0.1:18081;
